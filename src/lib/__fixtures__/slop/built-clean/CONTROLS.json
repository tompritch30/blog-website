{
  "layout": [
    { "kind": "link", "href": "#main", "job": "skip the navigation" },
    { "kind": "link", "href": "/", "job": "go to the home page" }
  ],
  "routes": {
    "/": { "controls": [{ "kind": "link", "href": "/writing/*", "count": "many", "job": "open a post" }] },
    "/writing/[slug]": {
      "controls": [
        { "kind": "prose links", "job": "links the post cites" },
        { "kind": "scroll regions", "job": "wide code blocks scroll by keyboard" }
      ]
    }
  }
}
